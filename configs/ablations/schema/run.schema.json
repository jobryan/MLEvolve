{
  "schema_version": "1.0",
  "record_type": "run",
  "required": [
    "schema_version",
    "run_id",
    "system",
    "benchmark_track",
    "task_id",
    "variant_id",
    "phase",
    "seed",
    "status",
    "budget",
    "grader",
    "artifacts"
  ],
  "fields": {
    "schema_version": {"type": "string"},
    "run_id": {"type": "string"},
    "system": {"type": "string", "enum": ["mlevolve", "ai_scientist_v2"]},
    "benchmark_track": {"type": "string", "enum": ["shared_mle_bench_lite", "mlevolve_native", "ai_scientist_native", "diagnostic"]},
    "task_id": {"type": "string"},
    "task_manifest_version": {"type": "string"},
    "variant_id": {"type": "string"},
    "phase": {"type": "string", "enum": ["smoke", "screening", "main", "confirmation", "native_finalist"]},
    "seed": {"type": "integer"},
    "status": {"type": "string", "enum": ["planned", "running", "success", "invalid_submission", "timeout", "runtime_error", "grader_error", "audit_failed", "budget_exceeded", "cancelled", "blocked"]},
    "started_at": {"type": ["string", "null"]},
    "completed_at": {"type": ["string", "null"]},
    "git_commit": {"type": ["string", "null"]},
    "git_branch": {"type": ["string", "null"]},
    "command": {"type": ["string", "null"]},
    "output_dir": {"type": ["string", "null"]},
    "budget": {"type": "object"},
    "actual": {"type": "object"},
    "model_routing": {"type": "object"},
    "config_overrides": {"type": "object"},
    "resource_policy": {"type": "object"},
    "grader": {"type": "object"},
    "audit_summary": {"type": "object"},
    "metrics": {"type": "object"},
    "artifacts": {"type": "object"},
    "error": {"type": ["object", "null"]},
    "notes": {"type": ["string", "null"]}
  }
}
