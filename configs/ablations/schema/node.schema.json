{
  "schema_version": "1.0",
  "record_type": "node",
  "required": [
    "schema_version",
    "node_id",
    "run_id",
    "system",
    "task_id",
    "variant_id",
    "seed",
    "operator",
    "status",
    "created_at",
    "artifacts"
  ],
  "fields": {
    "schema_version": {"type": "string"},
    "node_id": {"type": "string"},
    "run_id": {"type": "string"},
    "system": {"type": "string", "enum": ["mlevolve", "ai_scientist_v2"]},
    "task_id": {"type": "string"},
    "variant_id": {"type": "string"},
    "seed": {"type": "integer"},
    "operator": {"type": "string", "enum": ["Draft", "Debug", "Improve", "Evolution", "Fusion/Crossover", "Aggregation", "Ablation", "Review", "Memory", "Evaluation"]},
    "stage": {"type": ["string", "null"]},
    "parent_node_ids": {"type": "array"},
    "reference_node_ids": {"type": "array"},
    "branch_id": {"type": ["string", "null"]},
    "depth": {"type": ["integer", "null"]},
    "status": {"type": "string", "enum": ["planned", "running", "success", "invalid_submission", "timeout", "runtime_error", "grader_error", "audit_failed", "budget_exceeded", "cancelled", "blocked"]},
    "created_at": {"type": "string"},
    "completed_at": {"type": ["string", "null"]},
    "prompt_paths": {"type": "array"},
    "generated_code_path": {"type": ["string", "null"]},
    "submission_path": {"type": ["string", "null"]},
    "grader_output_path": {"type": ["string", "null"]},
    "audit_output_path": {"type": ["string", "null"]},
    "metric_name": {"type": ["string", "null"]},
    "metric_direction": {"type": ["string", "null"], "enum": ["minimize", "maximize", null]},
    "validation_score": {"type": ["number", "null"]},
    "final_score": {"type": ["number", "null"]},
    "normalized_score": {"type": ["number", "null"]},
    "wall_time_seconds": {"type": ["number", "null"]},
    "cost": {"type": "object"},
    "token_usage": {"type": "object"},
    "memory_sources": {"type": "object"},
    "selection": {"type": "object"},
    "diversity": {"type": "object"},
    "artifacts": {"type": "object"},
    "error": {"type": ["object", "null"]},
    "notes": {"type": ["string", "null"]}
  }
}
